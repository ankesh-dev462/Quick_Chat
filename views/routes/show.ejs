<!-- <%-layout("./layouts/boilerplate.ejs")%> -->
<body>
    <div class="chat-container">
     <h3 class="username"><img src=<%=result.img_src%>>  <i>@<%=result.to%>...</i></h3> 
     <p class="date" style="text-align: center; font-weight: 100;"><%=result.createdAt.toString().split(" ").slice(0,4).join(" ")%> </p>
    <% for(let i=0; i<result.to_message.length; i++){ %>
        <p class="to"><%=result.to_message[i]%> &nbsp;&nbsp;&nbsp;<a class="edit" href="http://localhost:8080/chat/edit/<%=result._id%>/<%=i%>">Edit..</a>&nbsp;&nbsp;&nbsp; <%=result.createdAt.toString().split(" ")[4]%>
        </p>
   


        <p class="from"><%=result.from_message[i]%></p>
        
        <%}%>
        
        <form method="post" action="http://localhost:8080/chat/show/<%=result._id%>/add" class="edit-form">
                <input type="text" placeholder="enter your message" name="to" class="to-input">
                <button>Send</button>
            </form>
        
            <p class="inp">Chat with <%=result.to%>...</p>
            <div class="input">
            <form method="post" action="http://localhost:8080/chat/show/<%=result._id%>/add">
                <input type="text" placeholder="enter your message" name="to" class="to-input">
                <button>Send</button>
            </form>
        </div>
        </div>
          
</body>