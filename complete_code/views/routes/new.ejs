<%-layout("./layouts/boilerplate.ejs")%>
<body>
<br>
<form action="http://localhost:8080/chat/new" method="post" novalidate class="needs-validation">
<div class="row offset-2">
    <div class="col-9">
        <h3>Add New User..</h3>
        <br>
        <div class="mb-3">
  <label for="exampleFormControlInput1" class="form-label">UserName:</label>
  <input type="text" class="form-control" id="exampleFormControlInput1" name="to" required>
  <div class="valid-feedback">Username Looks good</div>
  <div class="invalid-feedback">Please enter a valid username</div>
</div>
<div class="mb-3">
  <label for="exampleFormControlTextarea1" class="form-label" >Enter Message</label>
  <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" name="to_message" required></textarea>
    <div class="valid-feedback">Message Looks good</div>
  <div class="invalid-feedback">Please enter a valid Message</div>
</div>
<div class="btn">
    <button class="btn btn-success">Save User</button>
</div>
</div>
</div>
</form>
</body>